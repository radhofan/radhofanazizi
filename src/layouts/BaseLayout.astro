---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Homepage', description = 'Personal blog and technical notes' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=12.0, minimum-scale=1.0, user-scalable=yes" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 2ch;">
      <a href="/" class="title">Radhofan Azizi Ramdhani</a>
      <div style="display: flex; gap: 1.5ch; align-items: center;">
        <!-- Email -->
        <a href="mailto:radhofanazizi@gmail.com" title="Email" aria-label="Email">
          <svg fill="#555" aria-hidden="true" height="24" viewBox="0 0 24 24" width="24">
            <path d="M0 3 h24 v17.5 H0 Z M24 5.5 L12 13 L0 5.5 v2 L12 15 L24 7.5 Z"></path>
          </svg>
        </a>
        <!-- LinkedIn -->
        <a href="https://www.linkedin.com/in/radhofan-azizi/" target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="LinkedIn">
          <svg fill="#555" aria-hidden="true" height="21" viewBox="0 0 24 24" width="21">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.65 1.65 0 0 0-1.66 1.66 1.66 1.66 0 0 0 1.66 1.66 1.65 1.65 0 0 0 1.65-1.66 1.65 1.65 0 0 0-1.65-1.66Z"></path>
          </svg>
        </a>
        <!-- Github -->
        <a href="https://github.com/radhofan" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub">
          <svg fill="#555" aria-hidden="true" height="21" viewBox="0 0 24 24" width="21">
            <path d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"></path>
          </svg>
        </a>
      </div>
    </div>
    <nav style="display: flex; gap: 2ch; margin-top: 1.5ch; font-weight: bold; text-transform: uppercase; flex-wrap: wrap;">
      <a href="/" class={currentPath === '/' ? 'active-nav' : ''}>Home</a>
      <a href="/experience" class={currentPath === '/experience' ? 'active-nav' : ''}>Experience</a>
      <a href="/projects" class={currentPath === '/projects' ? 'active-nav' : ''}>Projects</a>
      <a href="/publications" class={currentPath === '/publications' ? 'active-nav' : ''}>Publications</a>
      <a href="/articles" class={currentPath === '/articles' || currentPath.startsWith('/posts') ? 'active-nav' : ''}>Articles</a>
      <a href="/cv" class={currentPath === '/cv' ? 'active-nav' : ''}>CV</a>
    </nav>
    <br />
    <slot />
  </body>
</html>
