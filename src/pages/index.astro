---
import BaseLayout from '../layouts/BaseLayout.astro';

const experiences = [
  {
    title: 'AI Product Engineer',
    company: 'WorldWhite Enterprise',
    location: 'South Jakarta, ID',
    type: 'Full-Time',
    duration: 'Sep 2026 – Present',
    responsibilities: [
      'Sole engineer owning the end-to-end development of an AI-powered fashion styling mobile app across iOS and Android.',
      'Built automated computer vision pipelines, real-time outfit recommendation models, backend infrastructure from scratch and handle DevOps pipeline.'
    ],
    skills: ['AI Engineering', 'Computer Vision', 'Recommendation Systems', 'Mobile Development', 'DevOps']
  },
  {
    title: 'Software Engineer',
    company: 'Zeta Solutions',
    location: 'Bandung, ID',
    type: 'Part-Time',
    duration: 'Jun 2025 – Aug 2026',
    responsibilities: [
      'Built order management, warehouse management, and internal chat features for 30+ internal users using Next.js and PostgreSQL.',
      'Migrated 10,000+ legacy records from Excel and paper-based workflows into a centralized database-backed application.',
      'Developed 15+ reusable React components, including Kanban boards, file uploaders, and real-time chat modules.',
      'Implemented a Qiankun-based microfrontend setup to separate internal modules and simplify deployment to AWS S3.',
      'Designed responsive wedding invitation websites for client campaigns supporting 1,000+ visitors across mobile and desktop browsers.'
    ],
    skills: ['Next.js', 'PostgreSQL', 'React', 'Microfrontend', 'AWS S3']
  },
  {
    title: 'Software Engineer Intern',
    company: 'Indonesian State Electricity Company PLN',
    location: 'Jakarta, ID',
    type: 'Intern',
    duration: 'Jun 2025 – Aug 2025',
    responsibilities: [
      'Built an internal Unit Price Contract management system to digitize procurement workflows and reduce manual document tracking.',
      'Developed full-stack features using Next.js and PostgreSQL, including JWT authentication, custom middleware, and role-based access control.',
      'Designed protected routes and permission-based UI flows for different internal user roles.'
    ],
    skills: ['Next.js', 'PostgreSQL', 'JWT', 'RBAC', 'Full-stack']
  }
];

const publications = [
  {
    title: 'Enhancing User-Side Fairness on Neural Collaborative Filtering Using Generative Adversarial Network-Based Augmentation',
    authors: 'Radhofan Azizi Ramdhani, Rita Rismala',
    conference: '2026 14th International Conference on Information and Communication Technology (ICoICT)',
    publisher: 'IEEE',
    year: '2026',
    url: 'https://ieeexplore.ieee.org/document/11664748',
    description: 'Mitigating user-side fairness disparities in recommender systems by augmenting sparse interaction data via Generative Adversarial Networks (GANs).'
  }
];
---

<BaseLayout title="Homepage">
  <div class="heading">About</div>

  <div style="display: flex; gap: 2.5ch; align-items: flex-start; margin-bottom: 2ch; flex-wrap: wrap;">
    <img
      src="/profile.jpg"
      alt="Radhofan Azizi"
      style="width: 175px; height: 175px; object-fit: cover; border: none; outline: none; border-radius: 6px; flex-shrink: 0;"
    />
    <div style="flex: 1; min-width: 260px;">
      <p style="margin-top: 0; line-height: 1.6;">
        👋 Hi, my name is Radhofan! I am a Fullstack Software & AI Engineer. I specialize in clean code quality, modern software architecture, and translating complex business goals into effective, scalable technical solutions.
      </p>
      <p style="line-height: 1.6; margin-bottom: 0;">
        🚀 I am also deeply interested in research, particularly at the intersection of software engineering, system architecture, and machine learning.
      </p>
    </div>
  </div>

  <div class="heading">Publications</div>

  <ul style="padding-left: 2.5ch; margin-top: 1ch; margin-bottom: 2ch;">
    {
      publications.map((pub) => (
        <li style="margin-bottom: 2ch;">
          <a href={pub.url} target="_blank" rel="noopener noreferrer" style="font-weight: bold;">
            {pub.title}
          </a>
          <div style="color: #444; font-size: 0.9em; margin-top: 0.3ch;">
            {pub.authors}
          </div>
          <div style="color: #666; font-size: 0.85em; font-style: italic; margin-top: 0.2ch;">
            {pub.conference} &bull; {pub.publisher} ({pub.year})
          </div>
          <div style="margin-top: 0.5ch; font-size: 0.95em;">
            {pub.description}
          </div>
        </li>
      ))
    }
  </ul>

  <div class="heading">Experience</div>

  <div style="display: flex; flex-direction: column; gap: 3ch; margin-bottom: 5ch;">
    {
      experiences.map((exp) => (
        <div>
          <div style="font-weight: bold; font-size: 1.05em;">
            {exp.title} | {exp.company}
          </div>
          <div style="color: #666; font-size: 0.9em; margin-bottom: 0.8ch;">
            {exp.duration} &bull; {exp.location} &bull; {exp.type}
          </div>
          <ul style="margin: 0.5ch 0; padding-left: 2.5ch;">
            {exp.responsibilities.map((item) => (
              <li style="margin-bottom: 0.4ch;">{item}</li>
            ))}
          </ul>
          <div style="font-size: 0.85em; color: #555; margin-top: 0.5ch;">
            <strong>Tech:</strong> {exp.skills.join(', ')}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
