---
import BaseLayout from '../layouts/BaseLayout.astro';

const experiences = [
  {
    title: 'Software Engineer',
    company: 'Zeta Solutions',
    location: 'Bandung, ID',
    type: 'Part-Time',
    duration: 'Jun 2025 – Aug 2026',
    responsibilities: [
      'Built order management, warehouse management, and internal chat features for 30+ internal users using Next.js and PostgreSQL.',
      'Migrated 10,000+ legacy records from Excel and paper-based workflows into a centralized database-backed application.',
      'Developed 15+ reusable React components, including Kanban boards, file uploaders, and real-time chat modules.',
      'Implemented a Qiankun-based microfrontend setup to separate internal modules and simplify deployment to AWS S3.',
      'Designed responsive wedding invitation websites for client campaigns supporting 1,000+ visitors across mobile and desktop browsers.'
    ],
    skills: ['Next.js', 'PostgreSQL', 'React', 'Microfrontend', 'AWS S3']
  },
  {
    title: 'Software Engineer Intern',
    company: 'Indonesian State Electricity Company PLN',
    location: 'Jakarta, ID',
    type: 'Intern',
    duration: 'Jun 2025 – Aug 2025',
    responsibilities: [
      'Built an internal Unit Price Contract management system to digitize procurement workflows and reduce manual document tracking.',
      'Developed full-stack features using Next.js and PostgreSQL, including JWT authentication, custom middleware, and role-based access control.',
      'Designed protected routes and permission-based UI flows for different internal user roles.'
    ],
    skills: ['Next.js', 'PostgreSQL', 'JWT', 'RBAC', 'Full-stack']
  }
];
---

<BaseLayout title="Experience">
  <div class="heading">Experience</div>

  <div style="display: flex; flex-direction: column; gap: 3ch;">
    {
      experiences.map((exp) => (
        <div>
          <div style="font-weight: bold; font-size: 1.05em;">
            {exp.title} | {exp.company}
          </div>
          <div style="color: #666; font-size: 0.9em; margin-bottom: 0.8ch;">
            {exp.duration} &bull; {exp.location} &bull; {exp.type}
          </div>
          <ul style="margin: 0.5ch 0; padding-left: 2.5ch;">
            {exp.responsibilities.map((item) => (
              <li style="margin-bottom: 0.4ch;">{item}</li>
            ))}
          </ul>
          <div style="font-size: 0.85em; color: #555; margin-top: 0.5ch;">
            <strong>Tech:</strong> {exp.skills.join(', ')}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
